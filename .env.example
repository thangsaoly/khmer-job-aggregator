# ─── Gemini AI (required for AI classification pipeline) ────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Apify (required for live TikTok scraping via cron) ─────────────────────
# Get your token at: https://apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# ─── Turso (LibSQL) Database ─────────────────────────────────────────────────
# Local dev: leave as file:./jobs.db (no token needed)
# Production: get from https://turso.tech → your database → Connect
TURSO_DB_URL=file:./jobs.db
TURSO_DB_AUTH_TOKEN=

# ─── Express Server ──────────────────────────────────────────────────────────
PORT=3001
